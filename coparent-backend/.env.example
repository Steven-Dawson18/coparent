DATABASE_URL=postgresql://coparent_app:replace_me@localhost:5432/coparent
AUTH_MODE=local
JWT_SECRET=replace_with_at_least_32_random_characters
# For production managed identity, set AUTH_MODE=oidc and configure:
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=coparent-api
# OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
CORS_ORIGIN=http://localhost:5173
PORT=3000
EMAIL_PROVIDER=development
EMAIL_WORKER_ENABLED=true
NOTIFICATION_WORKER_ENABLED=true
# Generate with: openssl rand -base64 32
EMAIL_OUTBOX_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key
# Encrypted files are stored outside the public web root. Use a durable mounted
# directory in production and a separate key from the email outbox key.
FILE_STORAGE_ROOT=./private-storage
# Generate with: openssl rand -base64 32
FILE_STORAGE_ENCRYPTION_KEY=replace_with_a_different_base64_encoded_32_byte_key
# Required only when EMAIL_PROVIDER=resend:
# RESEND_API_KEY=re_replace_me
# RESEND_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# EMAIL_FROM=CoParent <invitations@example.com>
